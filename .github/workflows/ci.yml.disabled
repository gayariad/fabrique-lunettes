name: CI - Tests et Release

# declencheurs : lancer le workflow à chaque push sur main et sur chaque pull request vers main
on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

jobs:
  #job 1 : lancer les tests dans un job separe pour pouvoir les publier dans l'interface GitHub et ne creer la release que si les tests passent 
  tests:
    name: Tests JUnit
    runs-on: ubuntu-latest
    permissions:
      checks: write
      contents: read

    steps:
      # etape 1 : recuperer le code du depot
      - name: Checkout du code
        uses: actions/checkout@v4

      # etape 2 : installer Java 17
      - name: Installer Java 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      # etape 3 : mettre en cache les dependances Maven
      # evite de tout retelecharger a chaque run (gain de temps)
      - name: Cache Maven
        uses: actions/cache@v4
        with:
          path: ~/.m2/repository
          key: ${{ runner.os }}-maven-${{ hashFiles('**/pom.xml') }}
          restore-keys: |
            ${{ runner.os }}-maven-

      # etape 4 : configurer l'acces au depot GitHub Packages pour la lib fabricateur
      # le token GITHUB_TOKEN est fourni automatiquement par GitHub Actions
      - name: Configurer settings.xml pour GitHub Packages
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'
          server-id: github-fabricateur
          server-username: GITHUB_ACTOR
          server-password: GITHUB_TOKEN

      # etape 5 : lancer tous les tests sans lancer l'application
      - name: Lancer les tests Maven
        run: mvn -B test --no-transfer-progress
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      # etape 6 : publier le rapport de tests dans l'interface GitHub
      - name: Publier les resultats des tests
        uses: dorny/test-reporter@v1
        if: always()
        with:
          name: Resultats JUnit
          path: '**/target/surefire-reports/*.xml'
          reporter: java-junit

  # job 2 : creer une release GitHub avec les JARs en pieces jointes, mais seulement si les tests du job 1 passent et seulement pour les push sur main (pas pour les PR)
  release:
    name: Creer une Release
    runs-on: ubuntu-latest
    needs: tests
    if: github.event_name == 'push' && github.ref == 'refs/heads/main'
    permissions:
      contents: write

    steps:
      - name: Checkout du code
        uses: actions/checkout@v4

      - name: Installer Java 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Cache Maven
        uses: actions/cache@v4
        with:
          path: ~/.m2/repository
          key: ${{ runner.os }}-maven-${{ hashFiles('**/pom.xml') }}
          restore-keys: |
            ${{ runner.os }}-maven-

      - name: Configurer settings.xml pour GitHub Packages
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'
          server-id: github-fabricateur
          server-username: GITHUB_ACTOR
          server-password: GITHUB_TOKEN

      # compiler et packager sans relancer les tests
      - name: Compiler et packager
        run: mvn -B package -DskipTests --no-transfer-progress
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      # generer un numero de version unique base sur la date et le numero du run
      # ex: v20226.03.30-42
      - name: Generer le tag de version
        id: version
        run: echo "tag=v$(date +'%Y.%m.%d')-${{ github.run_number }}" >> $GITHUB_OUTPUT

      # creer la release GitHub avec les JARs en pieces jointes
      - name: Creer la Release GitHub
        uses: softprops/action-gh-release@v2
        with:
          tag_name: ${{ steps.version.outputs.tag }}
          name: "Release ${{ steps.version.outputs.tag }}"
          body: |
            Release automatique generee par GitHub Actions.
            Commit : ${{ github.sha }}
          files: |
            backend/target/*.jar
            client/target/*.jar
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
