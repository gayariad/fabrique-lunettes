<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="800.0" spacing="16.0"
        fx:controller="com.lunettes.controller.VerificationController"
        xmlns:fx="http://javafx.com/fxml/1"
        xmlns="http://javafx.com/javafx/21">

        <Button fx:id="btnRetour" text="← Retour" onAction="#onRetour" 
        style="-fx-font-size: 13px;"
        VBox.vgrow="NEVER"/>

    <padding>
        <Insets top="40.0" bottom="40.0" left="40.0" right="40.0" />
    </padding>

    <Label text="Vérification d'un numéro de série" style="-fx-font-size: 20px; -fx-font-weight: bold;" />

    <HBox alignment="CENTER" spacing="10.0">
        <TextField fx:id="txtSerial" prefWidth="300.0" promptText="Numéro de série" />
        <Button fx:id="btnVerifier" onAction="#onVerifier" text="Vérifier" />
    </HBox>

    <Label fx:id="lblResultat" text="" wrapText="true" style="-fx-font-size: 14px;" />
</VBox>
